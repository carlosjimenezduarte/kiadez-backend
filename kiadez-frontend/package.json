{
  "name": "kiadez-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-route-aliases.mjs",
    "preview": "vite preview",
    "android:icon": "bash scripts/android-icons.sh",
    "cap:sync": "npx cap sync android",
    "cap:sync:remote": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:prepare": "npm run build && npm run cap:sync",
    "android:prepare:remote": "npm run cap:sync:remote",
    "android:apk:debug": "bash scripts/android-gradle.sh assembleDebug",
    "android:apk:release": "bash scripts/android-gradle.sh assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.43.8",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0"
  }
}
